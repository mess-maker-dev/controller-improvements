<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<ItemButton name="CIItemButtonTemplate" inherits="BankItemButtonTemplate" mixin="CIItemButtonMixin" virtual="true">
		<Size x="37" y="37"/>
		<Frames>
			<Frame name="$parentMoney" parentKey="Money" inherits="SmallMoneyFrameTemplate" hidden="true"/>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</ItemButton>

	<Frame name="CICombinedPanel" parent="UIParent" inherits="BackdropTemplate" mixin="CICombinedPanelMixin"
		   hidden="true" enableMouse="true" toplevel="true" frameStrata="DIALOG" clampedToScreen="true">
		<Size x="740" y="440"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer>
				<FontString name="$parentTitleText" parentKey="TitleText" inherits="GameFontNormalLarge" text=""/>
				<FontString name="$parentPageText" parentKey="PageText" inherits="GameFontNormal" text="" hidden="true"/>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentMoneyDisplay" parentKey="MoneyDisplay" inherits="SmallMoneyFrameTemplate"/>
			<Frame name="$parentBagSide" parentKey="BagSide" enableMouse="true">
				<Size x="470" y="330"/>
			</Frame>
			<Frame name="$parentRightSide" parentKey="RightSide" enableMouse="true">
				<Size x="200" y="330"/>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>
</Ui>
